breed [radio-buttons radio-button]
breed [radio-button-labels radio-button-label]

radio-buttons-own [
  on-off?
]

globals [
  selection
  radio-buttons-panel
  radio-buttons-on-off-switch
]

to setup-buttons [#list #switch]
  set selection #list
  set radio-buttons-on-off-switch #switch
  setup-radio-buttons-panel
  hide-panel
  update-output
end

to setup-radio-buttons-panel
  let #aspect 0.2 * length selection
  let #width min (list (world-width / 2) (400 / patch-size)) 
  let #width-fraction #width / world-width
  show (word #width #width-fraction world-width patch-size)
  let #min-x min-pxcor + (world-width) * #width-fraction / 2
  let #max-x max-pxcor - (world-width) * #width-fraction / 2
  let #min-y min-pycor + 3 * (world-height) / 8
  let #max-y min-pycor + 7 * (world-height) / 8
  set radio-buttons-panel patches with [ 
    pxcor > #min-x and pxcor < #max-x and 
    pycor > #min-y and pycor < #max-y 
  ]
  setup-radio-buttons #min-x #max-x #min-y #max-y
end

to setup-radio-buttons [#x1 #x2 #y1 #y2]
;  clear-all
  let #width #x2 - #x1
  let #height #y2 - #y1
  let #space #height / (length selection + 1)
  let #size #space * 0.8
  let #x #x2 - #space
  let #y #y2 - #space
  foreach range length selection [ i ->
    create-radio-buttons 1 [
      set on-off? item i selection
      set shape "circle"
      set size #size
      set color ifelse-value on-off? [ green ] [ red ]
      setxy #x #y - #space * i
      hatch 1 [
        set breed radio-button-labels
        setxy #x - #space / 2 #y - #space * i
        set size 0
        set label (word "button " i)
;        set label left-justify (word "button " i) 15
      ]
    ]
  ]
  update-output
end

to change-buttons
  ifelse runresult radio-buttons-on-off-switch [ show-panel ] [ stop ]
  while [runresult radio-buttons-on-off-switch] [
    if mouse-down? [
      let mx mouse-xcor
      let my mouse-ycor
      let #button-clicked one-of (radio-buttons with [distancexy mx my < size * 0.5])
      if #button-clicked != nobody [
        ask #button-clicked [
          set on-off? not on-off?
          set selection replace-item who selection on-off?
          set color ifelse-value on-off? [ green ] [ red ]
        ]
        update-output
      ]
    ]
    wait 0.2
  ]
  hide-panel
end

to show-panel
  ask radio-buttons-panel [ set pcolor blue - 2 ]
  ask radio-buttons [ set hidden? false ]
  ask radio-button-labels [ set hidden? false ]
end

to hide-panel
  ask radio-buttons-panel [ set pcolor black ]
  ask radio-buttons [ set hidden? true ]
  ask radio-button-labels [ set hidden? true ]
end

to update-output
  clear-output
  output-print join-list selection "\n" 
end

to-report join-list [#list #sep]
  report reduce [ [a b] -> (word a #sep b) ] #list
end
