    <view x="12" wrappingAllowedX="true" y="10" frameRate="30.0" minPycor="0" height="409" showTickCounter="true" patchSize="4.0" fontSize="10" wrappingAllowedY="true" width="408" tickCounterLabel="ticks" maxPycor="99" updateMode="0" maxPxcor="99" minPxcor="0"></view>
    <slider x="617" step="1" y="13" max="1000" display="number-of-draws" height="33" min="0" direction="Horizontal" default="99.0" variable="number-of-draws" width="187" sizeVersion="0"></slider>
    <slider x="617" step="0.0001" y="51" max="1" display="probability" height="33" min="0" direction="Horizontal" default="0.1163" variable="probability" width="187" sizeVersion="0"></slider>
    <button x="450" y="13" height="33" disableUntilTicks="false" forever="false" kind="Observer" display="test-binomial" width="125" sizeVersion="0">ask patches [
  set value random-binomial number-of-draws probability
]
update-displays true</button>
    <button x="449" y="96" height="33" disableUntilTicks="false" forever="false" kind="Observer" display="test-multinomial" width="147" sizeVersion="0"><![CDATA[ask patches [
  set weight random-poisson multinomial-mean
]
let weights map [p -> [weight] of p] sort patches
let values random-multinomial-int (count patches * number-of-draws) weights
(foreach sort patches values [ [p v] ->
  ask p [set value v]
]) 
update-displays colour-by-value?
]]></button>
