;; additional string utilities for Netlogo

to-report string-as-list [str]
  report n-values length str [i -> item i str]
end

to-report split-string [str sep]
  let words []
  let this-word ""
  foreach (string-as-list str) [ c ->
    ifelse c = sep
    [ set words sentence words this-word
      set this-word "" ]
    [ set this-word word this-word c ]
  ]
  set words sentence words this-word
  report filter [s -> s != sep and s != ""] words
end

to-report strip [#s]
  report left-strip right-strip #s
end

to-report left-strip [#s]
  let result #s
  while [first result = " "] [ set result but-first result ]
  report result
end

to-report right-strip [#s]
  let result #s
  while [last result = " "] [ set result but-last result ]
  report result
end

to-report replace [#s #pattern #replace]
  let result #s
  if is-list? #pattern [
    (foreach #pattern #replace [ [pat rep] ->
      set result replace-one-pattern result pat rep
    ])
    report result
  ]
  report replace-one-pattern #s #pattern #replace
end

to-report replace-one-pattern [#s #pattern #replace]
  let result ""
  let breaks str-matches #s #pattern
  if length breaks = 0 [ report #s ]
  let matched-sets map [i -> n-values length #pattern [j -> j + i]] breaks
  let matched reduce [[pat rep] -> (sentence pat rep)] matched-sets
  let unmatched filter [x -> not member? x matched] range length #s
  foreach range length #s [ i ->
    if member? i breaks [ set result (word result #replace) ]
    if member? i unmatched [ set result (word result item i #s) ]
  ]
  report result
end

to-report upper-case [#s]
  report case #s "U"
end

to-report lower-case [#s]
  report case #s "L"
end

to-report case [#s #upper-or-lower]
  let lower-abc string-as-list "abcdefghijklmnopqrstuvwxyz"
  let upper-abc string-as-list "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
  if #upper-or-lower = "U" [ report replace #s lower-abc upper-abc ]
  report replace #s upper-abc lower-abc
end

;  See:
;  https://en.wikipedia.org/wiki/Knuth-Morris-Pratt_algorithm which provides
;  detailed pseudo-code on which this code is directly based. See also:
;
;    Knuth DE, JH Morris Jr, and VR Pratt. 1977. Fast pattern  matching in
;    strings. SIAM Journal on Computing 6(2): 323-350. doi: 10.1137/0206024.
;
;  Note that the terse variable names are those used in the KMP 1977 paper.
to-report str-matches [#s #pat]
  let [j k] [0 0]
  let finds []
  let table get-table #pat
  while [ j < length #s ] [
    ifelse item k #pat = item j #s [
      set j j + 1
      set k k + 1
      if k = length #pat [
        set finds lput (j - k) finds
        set k item k table
      ]
    ]
    [
      set k item k table
      if k < 0 [
        set j j + 1
        set k k + 1
      ]
    ]
  ]
  report finds
end

to-report get-table [#pat]
  let pos 1
  let cnd 0
  let T (sentence [-1] n-values length #pat [i -> nobody])
  while [ pos < length #pat ] [
    ifelse item pos #pat = item cnd #pat [
      set T replace-item pos T item cnd T
    ]
    [
      set T replace-item pos T cnd
      while [ cnd >= 0 and item pos #pat != item cnd #pat ] [
        set cnd item cnd T
      ]
    ]
    set pos pos + 1
    set cnd cnd + 1
  ]
  report replace-item pos T cnd
end


