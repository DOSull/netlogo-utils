;; additional list utilities for Netlogo

to-report cumulative-proportion [#list]
  if length #list = 0 [ report [] ]
  let s sum #list
  if s = 0 [ report [0] ]
  report map [x -> x / s] cumulative-sum #list
end

to-report cumulative-sum [#list]
  report but-first reduce [ [a b] -> lput (last a + b) a] (fput [0] #list)
end

to-report insert-value-in-order [#list #x]
  report (sentence filter [v -> v < #x] #list #x filter [v -> v >= #x] #list)
end

to-report insert-values-in-order [#list-1 #list-2]
  report reduce [ [a b] -> insert-value-in-order a b] (fput #list-1 #list-2)
end

to-report join-list [#list #sep]
  report reduce [ [a b] -> (word a #sep b) ] #list
end

to-report last-position [#x #list]
  report length #list - (position true (reverse matches #x #list)) - 1
end

to-report matches [#x #list]
  report map [y -> #x = y] #list
end

to-report matching-positions [#x #list]
  let positions n-values length #list [i -> i]
  report filter [i -> item i #list = #x] positions
end

to-report pairs [#list1 #list2]
  report zip rep-list-each #list1 length #list2 rep-list-inline #list2 length #list1
end

to-report range-from-to-by [#start #finish #step]
  let n ceiling ((#finish - #start) / #step)
  if (#step * (#finish - #start)) < 0 [
    print "***WARNING: step size in sequence reporter is wrong sign. Returning empty list***"
    report []
  ]
  ifelse #finish > #start
  [ report n-values n [i -> #start + #step * i] ]
  [ report n-values n [i -> #start + #step * i] ]
end

to-report #range-from-to [#start #finish]
  ifelse #finish > #start
  [ report range-from-to-by #start #finish 1 ]
  [ report range-from-to-by #start #finish -1 ]
end

to-report #range-by [#finish #by]
  report range-from-to-by 0 #finish #by
end

to-report ranks [#list]
  let s sort #list
  report map [x -> position x s] #list
end

to-report rep-list [#list #n #inline?]
  if #n < 1 [ report [] ]
  if #n = 1 [ report #list ]
  ifelse #inline?
  [ report rep-list-inline #list #n ]
  [ report rep-list-each #list #n ]
end

to-report rep-list-each [#list #n]
  report reduce [[a b] -> sentence a b ] map [i -> n-values #n [j -> i] ] #list
end

to-report rep-list-inline [#list #n]
  report reduce [[a b] -> sentence a b ] map [i -> #list] range #n
end
  
to-report slice [#list #slice-indexes]
  report map [i -> item i #list] #slice-indexes
end

to-report split-list-at-value [#list #x] ;; assume list is ordered
  report (list filter [v -> v < #x] #list filter [v -> v >= #x] #list)
end

to-report transpose [#lists]
  let indexes range length first #lists
  report map [i -> map [L -> item i L] #lists] indexes
end

to-report unzip [#lists]
  report transpose #lists
end

to-report zip [#list1 #list2]
  report transpose (list #list1 #list2)
end

